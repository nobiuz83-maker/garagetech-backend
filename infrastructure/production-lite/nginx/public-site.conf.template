server {
    listen 80;
    listen [::]:80;
    server_name APP_DOMAIN;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name APP_DOMAIN;
    root FRONTEND_BUILD_DIRECTORY;
    index index.html;
    ssl_certificate TLS_CERTIFICATE;
    ssl_certificate_key TLS_PRIVATE_KEY;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    client_max_body_size 10m;
    include /etc/nginx/snippets/vicartech/security-headers.conf;

    location = /gateway-health { default_type text/plain; return 200 "ok\n"; }
    location ~ ^/(?:sanctum/csrf-cookie|login|logout|api/user) {
        include /etc/nginx/snippets/vicartech/proxy-auth.conf;
    }
    location ~ ^/api/v1/(?:clients|vehicles)(?:/|$) {
        include /etc/nginx/snippets/vicartech/proxy-clients.conf;
    }
    location ~ ^/api/v1/(?:appointments|appointment-schedule|appointment-availability|appointment-notification-[^/]+|public/appointment-cancellations)(?:/|$) {
        include /etc/nginx/snippets/vicartech/proxy-appointments.conf;
    }
    location ~ ^/api/v1/interventions(?:/|$) { include /etc/nginx/snippets/vicartech/proxy-interventions.conf; }
    location ~ ^/api/v1/inventory(?:/|$) { include /etc/nginx/snippets/vicartech/proxy-inventory.conf; }
    location ~ ^/api/v1/invoices(?:/|$) { include /etc/nginx/snippets/vicartech/proxy-billing.conf; }
    location ~ ^/api/v1/accounting(?:/|$) { include /etc/nginx/snippets/vicartech/proxy-accounting.conf; }
    location /api/ { return 404; }
    location ~ /\. { deny all; }
    location / { try_files $uri $uri/ /index.html; }
}
