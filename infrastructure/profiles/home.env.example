# Copy outside Git. HOME must use new secrets, new data and the real reserved VM IP.
VICARTECH_PROJECT_NAME=vicartech-home
VICARTECH_VOLUME_NAME=vicartech_home_database_data
PROFILE_BIND_IP=
PROFILE_HTTPS_PORT=443
PROFILE_HOST=
PROFILE_ORIGIN=
PROFILE_STATEFUL_DOMAIN=
PROFILE_FRONTEND_DIST=/absolute/path/to/garagetech-frontend/dist-home
PROFILE_SECRETS_DIR=/absolute/private/home-secrets
PROFILE_TLS_DIR=/absolute/private/home-tls
STAGE1_SECRETS_DIR=/absolute/private/home-secrets
AUTH_STAGE2A_SECRETS_DIR=/absolute/private/home-secrets
AUTH_STAGE2B_SECRETS_DIR=/absolute/private/home-secrets
