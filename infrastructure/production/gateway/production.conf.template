server {
    listen 80;
    server_name ${PUBLIC_DOMAIN};
    location = /gateway-health { return 200 'ok'; }
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name ${PUBLIC_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${PUBLIC_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TLS:10m;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    resolver 127.0.0.11 ipv6=off valid=10s;

    location = /gateway-health { default_type application/json; return 200 '{"gateway":"ok"}'; }
    location = /sanctum/csrf-cookie { include /etc/nginx/auth-proxy.conf; }
    location = /login { include /etc/nginx/auth-proxy.conf; }
    location = /logout { include /etc/nginx/auth-proxy.conf; }
    location = /api/user { include /etc/nginx/auth-proxy.conf; }

    location ~ ^/api/v1/(?:clients|vehicles)(?:/|$) { include /etc/nginx/clients-proxy.conf; }
    location ~ ^/api/v1/(?:appointments|appointment-schedule|appointment-availability|appointment-notification-[^/]+|public/appointment-cancellations)(?:/|$) { include /etc/nginx/appointments-proxy.conf; }
    location ~ ^/api/v1/interventions(?:/|$) {
        include /etc/nginx/workflow-headers.conf;
        proxy_pass http://interventions-service:8080$request_uri;
    }
    location ~ ^/api/v1/inventory(?:/|$) {
        include /etc/nginx/workflow-headers.conf;
        proxy_pass http://inventory-service:8080$request_uri;
    }
    location ~ ^/api/v1/invoices(?:/|$) {
        include /etc/nginx/workflow-headers.conf;
        proxy_pass http://billing-service:8080$request_uri;
    }
    location ~ ^/api/v1/accounting(?:/|$) {
        include /etc/nginx/workflow-headers.conf;
        proxy_pass http://accounting-service:8080$request_uri;
    }
    location /api/ { return 404; }
    location ~ /\. { return 404; }
    location / {
        proxy_pass http://frontend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    error_page 502 504 =503 /service-unavailable;
    location = /service-unavailable {
        internal;
        default_type application/json;
        return 503 '{"error":"UPSTREAM_SERVICE_UNAVAILABLE"}';
    }
}
