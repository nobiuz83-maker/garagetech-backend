[Unit]
Description=Create encrypted ViCarTech backup
After=mariadb.service

[Service]
Type=oneshot
User=root
Environment=MYSQL_DEFAULTS_FILE=/etc/vicartech/mariadb-backup.cnf
Environment=BACKUP_DIRECTORY=/var/backups/vicartech
Environment=AGE_RECIPIENT_FILE=/etc/vicartech/backup-age-recipient.txt
Environment=PRIVATE_STORAGE_ROOT=/srv/vicartech/shared/private-storage
ExecStart=/srv/vicartech/deployment/infrastructure/production-lite/scripts/backup.sh
MemoryMax=192M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/vicartech /srv/vicartech/shared/private-storage
