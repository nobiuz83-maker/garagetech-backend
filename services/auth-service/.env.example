APP_NAME=ViCarTech Auth Service
APP_ENV=local
APP_DEBUG=false
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=auth_db
DB_USERNAME=vicartech_auth_app
SESSION_DRIVER=database
SESSION_COOKIE=vicartech-auth-session
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
INTERNAL_AUTH_CLIENTS_KEY_FILE=/run/secrets/internal_clients_key
INTERNAL_AUTH_APPOINTMENTS_KEY_FILE=/run/secrets/internal_appointments_key
