APP_DOMAIN=replace-with-public-domain.example
APP_URL=https://replace-with-public-domain.example
FRONTEND_BUILD_DIRECTORY=/srv/vicartech/frontend/current
APP_ROOT=/srv/vicartech
APP_USER=vicartech
PHP_FPM_SOCKET_DIRECTORY=/run/php
TLS_CERTIFICATE=/etc/letsencrypt/live/replace-with-public-domain.example/fullchain.pem
TLS_PRIVATE_KEY=/etc/letsencrypt/live/replace-with-public-domain.example/privkey.pem
INTERNAL_TLS_DIRECTORY=/etc/vicartech/tls
INTERNAL_CA_CERTIFICATE=/etc/vicartech/tls/ca.crt
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
SESSION_SECURE_COOKIE=true
APP_DEBUG=false
