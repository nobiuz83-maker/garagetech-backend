# Copy outside Git and replace the directories with private OFFICE-only paths.
VICARTECH_PROJECT_NAME=vicartech-office
VICARTECH_VOLUME_NAME=vicartech_office_database_data
PROFILE_BIND_IP=127.0.0.1
PROFILE_HTTPS_PORT=8443
PROFILE_HOST=localhost
PROFILE_ORIGIN=https://localhost:8443
PROFILE_STATEFUL_DOMAIN=localhost:8443
PROFILE_FRONTEND_DIST=/absolute/path/to/garagetech-frontend/dist-office
PROFILE_SECRETS_DIR=/absolute/private/office-secrets
PROFILE_TLS_DIR=/absolute/private/office-tls
STAGE1_SECRETS_DIR=/absolute/private/office-secrets
AUTH_STAGE2A_SECRETS_DIR=/absolute/private/office-secrets
AUTH_STAGE2B_SECRETS_DIR=/absolute/private/office-secrets
