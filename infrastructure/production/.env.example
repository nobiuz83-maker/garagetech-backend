COMPOSE_PROJECT_NAME=vicartech-production
GHCR_OWNER=replace-with-lowercase-github-owner
BACKEND_IMAGE_TAG=main
FRONTEND_IMAGE_TAG=main
PUBLIC_DOMAIN=replace-with-public-domain.example
PUBLIC_ACME_EMAIL=replace-with-operations-email@example.com
PRODUCTION_ROOT=/opt/vicartech
PRODUCTION_SECRETS_DIR=/opt/vicartech/shared/secrets
PRODUCTION_DATA_DIR=/opt/vicartech/data
GMAIL_ENV_FILE=/opt/vicartech/shared/notification-provider.env
MARIADB_IMAGE=mariadb:10.6.28-ubi9
CERTBOT_IMAGE=certbot/certbot:v5.0.0
AGE_RECIPIENT_FILE=/opt/vicartech/shared/backup-age-recipient.txt
RCLONE_CONFIG=/opt/vicartech/shared/rclone.conf
OFFSITE_BACKUP_REMOTE=replace-with-existing-offsite-rclone-remote:vicartech-production
BACKUP_RETENTION_DAYS=30
TZ=America/Toronto
