APP_NAME="ViCarTech Appointments Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=vicartech_appointments
DB_USERNAME=vicartech_appointments_app
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
AUTH_SERVICE_URL=https://auth-service:8443
AUTH_CA_CERTIFICATE_FILE=/run/secrets/auth_ca_cert
AUTH_CLIENT_CERTIFICATE_FILE=/run/secrets/auth_client_cert
AUTH_CLIENT_KEY_FILE=/run/secrets/auth_client_key
AUTH_SIGNING_KEY_FILE=/run/secrets/auth_signing_key
