# Reference only. This file is outside .github/workflows and GitHub will not run it.
# Move it to .github/workflows only after reviewing SSH restrictions, adding a
# protected approval environment, and testing the same release manually.
name: PRODUCTION-LITE manual deployment reference

on:
  workflow_dispatch:
    inputs:
      approve_deployment:
        description: Explicitly approve upload to the configured host
        required: true
        type: choice
        options: [no, yes]
        default: no

permissions:
  contents: read

jobs:
  upload-release:
    if: inputs.approve_deployment == 'yes'
    environment: production-lite
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      # Add a SHA-pinned SSH agent action and verify known_hosts from the
      # protected environment before enabling uploads. Never use ssh-keyscan
      # in the deployment job as the host identity source.
      - name: Stop until SSH host and release transfer are reviewed
        run: |
          echo 'Deployment reference only; remote mutation is intentionally not implemented.'
          exit 1
