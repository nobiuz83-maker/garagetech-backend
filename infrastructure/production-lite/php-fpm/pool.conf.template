; Install one copy per service, substituting SERVICE_NAME and SERVICE_ROOT.
[SERVICE_NAME]
user = SERVICE_USER
group = SERVICE_GROUP
listen = /run/php/php8.3-fpm-SERVICE_NAME.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = ondemand
pm.max_children = 1
pm.process_idle_timeout = 10s
pm.max_requests = 300
request_terminate_timeout = 60s
catch_workers_output = yes
clear_env = yes
security.limit_extensions = .php
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
php_admin_value[error_log] = /var/log/php8.3-fpm-SERVICE_NAME.log
php_admin_value[memory_limit] = 96M
php_admin_value[upload_max_filesize] = 8M
php_admin_value[post_max_size] = 10M
php_admin_value[session.save_path] = SERVICE_ROOT/storage/framework/sessions
env[APP_ENV] = production
env[APP_DEBUG] = false
env[APP_CONFIG_CACHE] = SERVICE_ROOT/bootstrap/cache/config.php
env[APP_ROOT] = SERVICE_ROOT
