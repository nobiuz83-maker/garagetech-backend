server {
    listen 127.0.0.1:8443 ssl;
    server_name auth-service.internal;
    root AUTH_SERVICE_ROOT/public;
    ssl_certificate /etc/vicartech/tls/auth-service/server.crt;
    ssl_certificate_key /etc/vicartech/tls/auth-service/server.key;
    ssl_client_certificate /etc/vicartech/tls/ca.crt;
    ssl_verify_client on;
    ssl_verify_depth 1;
    location / { try_files $uri /index.php?$query_string; }
    location = /index.php {
        include /etc/nginx/snippets/vicartech/fastcgi-laravel.conf;
        fastcgi_param SCRIPT_FILENAME AUTH_SERVICE_ROOT/public/index.php;
        fastcgi_param DOCUMENT_ROOT AUTH_SERVICE_ROOT/public;
        fastcgi_pass unix:/run/php/php8.3-fpm-auth-service.sock;
    }
    location ~ /\. { deny all; }
}
