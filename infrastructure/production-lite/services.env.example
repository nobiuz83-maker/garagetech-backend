# Copy into a root-owned private directory, then create seven separate files.
# Never deploy this template directly.
APP_NAME="ViCarTech SERVICE_NAME"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://replace-with-public-domain.example
LOG_CHANNEL=stderr
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=replace_with_service_database
DB_USERNAME=vicartech
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
AUTH_SERVICE_URL=https://auth-service.internal:8443
AUTH_SERVICE_V2_URL=https://auth-service.internal:8443
AUTH_V2_URL=https://auth-service.internal:8443
AUTH_CA_CERTIFICATE_FILE=/etc/vicartech/tls/ca.crt
AUTH_V2_CA_CERTIFICATE_FILE=/etc/vicartech/tls/ca.crt
AUTH_CLIENT_CERTIFICATE_FILE=/etc/vicartech/tls/SERVICE_NAME/client.crt
AUTH_CLIENT_KEY_FILE=/etc/vicartech/tls/SERVICE_NAME/client.key
AUTH_V2_CLIENT_CERTIFICATE_FILE=/etc/vicartech/tls/SERVICE_NAME/client.crt
AUTH_V2_CLIENT_KEY_FILE=/etc/vicartech/tls/SERVICE_NAME/client.key
AUTH_SIGNING_KEY_FILE=/etc/vicartech/keys/SERVICE_NAME-auth-signing.key
AUTH_V2_SIGNING_KEY_FILE=/etc/vicartech/keys/SERVICE_NAME-auth-v2-signing.key
COMPANY_SECURITY_ENABLED=true
APPOINTMENTS_RELATIONSHIP_KEY_FILE=/etc/vicartech/keys/appointments-relationship.key
CLIENTS_RELATIONSHIP_KEY_FILE=/etc/vicartech/keys/appointments-relationship.key
BILLING_INVENTORY_KEY_FILE=/etc/vicartech/keys/billing-inventory.key
